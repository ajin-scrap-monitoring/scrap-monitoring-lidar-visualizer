# Docker --env-file로 주입할 공개 Live 설정 예제다.

# Visualizer가 Generator의 Observation TCP 연결을 수신할 주소와 port다.
LIDAR_VISUALIZER_TCP_HOST=0.0.0.0
LIDAR_VISUALIZER_TCP_PORT=17000

# Visualizer가 Browser preview를 제공할 HTTP 주소와 port다.
LIDAR_VISUALIZER_HTTP_HOST=0.0.0.0
LIDAR_VISUALIZER_HTTP_PORT=18000

# Renderer가 기본 camera와 frame 크기를 사용한다.
LIDAR_VISUALIZER_CAMERA=isometric
LIDAR_VISUALIZER_WIDTH=640
LIDAR_VISUALIZER_HEIGHT=360

# 기록을 사용할 때 아래 세 줄의 주석을 모두 제거한다.
# LIDAR_VISUALIZER_RECORD_PATH=/data/observations.ndjson
# LIDAR_VISUALIZER_RECORD_MAX_RECORDS=100000
# LIDAR_VISUALIZER_RECORD_MAX_BYTES=104857600

# Replay가 기본 재생 배율과 FPS를 사용한다.
LIDAR_VISUALIZER_TIME_SCALE=1
LIDAR_VISUALIZER_FPS=10

# Replay 선택값은 별도 Replay 설정 파일에서 필요한 값만 사용한다.
# LIDAR_VISUALIZER_OUTPUT_PATH=/output/replay.mp4
# LIDAR_VISUALIZER_RUN_ID=example-run
# LIDAR_VISUALIZER_START_S=0
# LIDAR_VISUALIZER_END_S=60
# LIDAR_VISUALIZER_DURATION_S=60
