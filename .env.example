# Docker --env-file로 주입할 공개 실행 설정 예제다.

# Visualizer가 Generator의 Observation TCP 연결을 수신할 주소와 port다.
SCRAP_MONITORING_VISUALIZER_TCP_HOST=0.0.0.0
SCRAP_MONITORING_VISUALIZER_TCP_PORT=17000

# Visualizer가 Browser preview를 제공할 HTTP 주소와 port다.
SCRAP_MONITORING_VISUALIZER_HTTP_HOST=0.0.0.0
SCRAP_MONITORING_VISUALIZER_HTTP_PORT=18000

# Renderer가 frame 크기를 사용한다.
SCRAP_MONITORING_VISUALIZER_WIDTH=1280
SCRAP_MONITORING_VISUALIZER_HEIGHT=720
